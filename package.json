{
  "name": "@madie/madie-root",
  "version": "0.0.3",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "prestart": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "concurrently -k -n webpack,server npm:start:webpack npm:start:server",
    "start:webpack": "webpack --watch --env isLocal",
    "start:server": "node scripts/dev-server.js",
    "lint": "eslint src --ext js,ts,tsx",
    "test": "cross-env BABEL_ENV=test jest",
    "coverage": "cross-env BABEL_ENV=test jest --coverage",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "prepare": "husky install",
    "build": "concurrently npm:build:*",
    "build:webpack": "webpack --mode=production",
    "build:types": "tsc"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/eslint-parser": "^7.18.2",
    "@babel/plugin-transform-runtime": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@babel/runtime": "^7.18.6",
    "@types/jest": "^30.0.0",
    "@types/systemjs": "^6.1.1",
    "@types/webpack-env": "^1.17.0",
    "concurrently": "^7.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.18.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-ts-important-stuff": "^1.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^8.0.1",
    "jest": "^30.5.2",
    "jsdom": "^26.1.0",
    "prettier": "^2.7.1",
    "pretty-quick": "^3.1.3",
    "ts-config-single-spa": "^3.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^6.0.1",
    "webpack-config-single-spa-ts": "^8.0.0",
    "webpack-merge": "^5.8.0",
    "webpack-pwa-manifest": "^4.0.0"
  },
  "dependencies": {
    "single-spa": "^5.9.4",
    "systemjs": "^6.12.1"
  },
  "overrides": {
    "path-to-regexp": "3.3.0",
    "compression": "^1.8.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0"
  },
  "types": "dist/madie-root-config.d.ts"
}
