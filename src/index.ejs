<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>MADiE</title>

  <link rel="apple-touch-icon" sizes="120x120" href="/assets/favicons/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/favicon-180x180.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16x16.png">

  <meta name="msapplication-square70x70logo" content="/assets/favicons/mstile-150x150.png">
  <meta name="msapplication-TileColor" content="#ffffff">
  <meta name="theme-color" content="#ffffff">

  <!--
    This CSP allows any SSL-enabled host and for arbitrary eval(), but you should limit these directives further to increase your app's security.
    Learn more about CSP policies at https://content-security-policy.com/#directive
  -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: localhost:*; script-src 'unsafe-inline' 'unsafe-eval' https: localhost:*; connect-src https: localhost:* ws://localhost:*; style-src 'unsafe-inline' https:; object-src 'none';">
  <meta name="importmap-type" content="importmap" />

  <!-- Include New Relic browser agent script -->
  <script type="text/javascript" src="newrelic.js"></script>
    <script type="importmap">
    {
      "imports": {
        "single-spa": "https://esm.sh/single-spa@latest",
        "react": "https://esm.sh/react@19",
        "react-dom": "https://esm.sh/react-dom@19",
        "react-dom/client": "https://esm.sh/react-dom@19/client",
        "rxjs": "https://esm.sh/rxjs@7",
        "rxjs/operators": "https://esm.sh/rxjs@7/operators",

         "react/jsx-runtime": "https://esm.sh/react@19.1.0/jsx-runtime",
         "react/jsx-dev-runtime": "https://esm.sh/react@19.1.0/jsx-dev-runtime",
        
        "@madie/root-config": "//localhost:9000/madie-root-config.js",
        "@madie/madie-layout": "//localhost:8500/madie-madie-layout.js",
        "@madie/madie-editor": "//localhost:8501/madie-madie-editor.js",
        "@madie/madie-auth": "//localhost:8502/madie-madie-auth.js",
        "@madie/madie-measure": "//localhost:8505/madie-madie-measure.js",
        "@madie/madie-cql-library": "//localhost:8507/madie-madie-cql-library.js",
        "@madie/madie-util": "//localhost:8508/madie-madie-util.js"
      }
    }
    </script>
     <!-- Matomo Tag Manager -->
  <script>
    var _mtm = window._mtm = window._mtm || [];
    _mtm.push({'mtm.startTime': (new Date().getTime()), 'event': 'mtm.Start'});
    (function() {
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src='https://qnetmatomo.cms.gov/js/container_7tO4JMwl.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/single-spa@5.9.0/lib/system/single-spa.min.js" as="script">
  <link href="https://global.oktacdn.com/okta-signin-widget/5.10.1/css/okta-sign-in.min.css" type="text/css" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/import-map-overrides@2.2.0/dist/import-map-overrides.js"></script>

</head>
<body>
  <noscript>
    You need to enable JavaScript to run this app.
  </noscript>
  <main id="main"></main>
  <div id="application-registry" style="display:none;">
    <div id="madie-editor"></div>
    <div id="madie-auth"></div>
    <div id="madie-cql-library"></div>
  </div>

  <script type="module">
      import { registerApplication, start } from "single-spa";
      import rootConfig from "/madie-root-config.js";
      rootConfig.forEach(app => registerApplication(app));
      start();
  </script>
  <import-map-overrides-full show-when-local-storage="devtools" dev-libs></import-map-overrides-full>
</body>
</html>
