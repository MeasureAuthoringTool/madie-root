{
  "presets": [
    ["@babel/preset-env", { "modules": false }],
    ["@babel/preset-react", { "runtime": "automatic" }],
    "@babel/preset-typescript"
  ],
  "plugins": [
    "babel-plugin-macros",
    [
      "@babel/plugin-transform-runtime",
      { "regenerator": false, "useESModules": true }
    ]
  ],
  "env": {
    "test": {
      "presets": [["@babel/preset-env", { "targets": "current node" }]]
    }
  }
}
